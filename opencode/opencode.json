{
    "$schema": "https://opencode.ai/config.json",
    "shell": "C:\\Program Files\\Git\\bin\\bash.exe",
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "Authorization": "Bearer ctx7sk-d7f968b5-1891-4a20-832d-92714b7130dd"
            },
            "enabled": false
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest"
            ],
            "enabled": false
        },
        "docker": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@mcp-get/docker"
            ],
            "enabled": false
        }
    },
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "qwen2.5-coder:7b-instruct-q4_K_M": {
                    "name": "qwen2.5-coder:7b-instruct-q4_K_M"
                },
                "qwen2.5vl:3b": {
                    "name": "qwen2.5vl:3b"
                },
                "qwen3.8-1bit:latest": {
                    "name": "qwen3.8-1bit:latest"
                },
                "qwen2.5-coder:3b": {
                    "name": "qwen2.5-coder:3b"
                }
            }
        }
    },
    "compaction": {
        "auto": true,
        "prune": true
    },
    "tool_output": {
        "max_lines": 250,
        "max_bytes": 10240
    },
    "small_model": "opencode/nemotron-3.5-lightning-free",
    "default_agent": "lead",
    "permission": {
        "bash": {
            "rm *": "ask",
            "* rm *": "ask",
            "*Remove-Item*": "ask",
            "*rm -rf*": "deny",
            "*rm -fr*": "deny",
            "*rmdir*": "deny",
            "* rd *": "deny",
            "del *": "deny",
            "* del *": "deny",
            "*format *": "deny",
            "*diskpart*": "deny",
            "*shutdown*": "deny",
            "*Stop-Computer*": "deny",
            "*Restart-Computer*": "deny",
            "*node -e*": "deny",
            "*node --eval*": "deny",
            "*python -c*": "deny",
            "*python3 -c*": "deny",
            "*python *.py*": "ask",
            "*node *.js*": "ask",
            "*iex *": "deny",
            "*Invoke-Expression*": "deny",
            "*EncodedCommand*": "deny",
            "*Set-ExecutionPolicy*": "deny",
            "*cat *": "deny",
            "*sed *": "deny",
            "*awk *": "deny",
            "*grep *": "deny",
            "*Get-Content*": "deny",
            "*Set-Content*": "deny",
            "*Add-Content*": "deny",
            "*Out-File*": "deny",
            "*Select-String*": "deny",
            "*Get-ChildItem*": "deny",
            "dir *": "deny",
            "* dir *": "deny",
            "*.env*": "deny",
            "*.env.example*": "allow"
        },
        "edit": {
            "**/.env*": "deny",
            "**/.env.example": "allow"
        },
        "read": {
            "**/.env*": "deny",
            "**/.env.example": "allow"
        },
        "grep": {
            "**/.env*": "deny",
            "**/.env.example": "allow"
        },
        "external_directory": {
            "*": "deny"
        }
    },
    "share": "manual",
    "agent": {
        "plan": {
            "disable": true
        },
        "build": {
            "disable": true
        }
    }
}