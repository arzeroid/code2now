{
    "$schema": "https://opencode.ai/config.json",
    "shell": "C:\\Program Files\\Git\\bin\\bash.exe",
    "compaction": {
        "auto": true,
        "prune": true
    },
    "tool_output": {
        "max_lines": 250,
        "max_bytes": 10240
    },
    "small_model": "opencode/nemotron-3.5-lightning-free",
    "default_agent": "lead",
    "permission": {
        "bash": {
            "rm *": "ask",
            "* rm *": "ask",
            "*Remove-Item*": "ask",
            "*rm -rf*": "deny",
            "*rm -fr*": "deny",
            "*rmdir*": "deny",
            "* rd *": "deny",
            "del *": "deny",
            "* del *": "deny",
            "*format *": "deny",
            "*diskpart*": "deny",
            "*shutdown*": "deny",
            "*Stop-Computer*": "deny",
            "*Restart-Computer*": "deny",
            "*node -e*": "deny",
            "*node --eval*": "deny",
            "*python -c*": "deny",
            "*python3 -c*": "deny",
            "*python *.py*": "ask",
            "*node *.js*": "ask",
            "*iex *": "deny",
            "*Invoke-Expression*": "deny",
            "*EncodedCommand*": "deny",
            "*Set-ExecutionPolicy*": "deny",
            "*cat *": "deny",
            "*sed *": "deny",
            "*awk *": "deny",
            "*grep *": "deny",
            "*Get-Content*": "deny",
            "*Set-Content*": "deny",
            "*Add-Content*": "deny",
            "*Out-File*": "deny",
            "*Select-String*": "deny",
            "*Get-ChildItem*": "deny",
            "dir *": "deny",
            "* dir *": "deny",
            "*.env*": "deny",
            "*.env.example*": "allow"
        },
        "edit": {
            "**/.env*": "deny",
            "**/.env.example": "allow"
        },
        "read": {
            "**/.env*": "deny",
            "**/.env.example": "allow"
        },
        "grep": {
            "**/.env*": "deny",
            "**/.env.example": "allow"
        },
        "external_directory": {
            "*": "deny"
        }
    },
    "share": "manual",
    "agent": {
        "plan": {
            "disable": true
        },
        "build": {
            "disable": true
        }
    }
}